# Automatic HTTPS for $DOMAIN (a real domain pointing at this server). With DOMAIN=localhost it serves a local certificate.
{$DOMAIN:localhost} {
	encode zstd gzip
	reverse_proxy web:3000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
