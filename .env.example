# ---- Database (self-hosted Postgres, see docker-compose.yml) ----
POSTGRES_USER=leks
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=leks
# Only needed when running outside docker compose (local dev, tests). Compose builds its own.
DATABASE_URL=postgres://leks:change-me-to-a-long-random-string@127.0.0.1:5432/leks

# ---- Site ----
DOMAIN=localhost
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret for signing/HMAC. Generate:  openssl rand -base64 32
APP_SECRET=
# Early-access form. Leave empty to store sign-ups only in the database.
WAITLIST_WEBHOOK_URL=

# ---- Email (verification links) ----
# console = print links in the server log (development only). smtp = send real email.
MAIL_DRIVER=console
MAIL_FROM="Leksmedia <support@leksmedias.com>"
SMTP_URL=smtp://user:pass@smtp.example.com:587

# ---- Providers ----
# demo = offline placeholder research and writing, no keys needed. Never use in production.
RESEARCH_PROVIDER=demo
LLM_PROVIDER=demo
TINYFISH_API_KEY=
ANTHROPIC_API_KEY=
# Models (defaults shown). Writer is the expensive one.
MODEL_WRITER=claude-sonnet-5-5
MODEL_FAST=claude-haiku-5-5

# ---- Worker ----
WORKER_CONCURRENCY=2
# Deep-research scripts running at once. Each uses up to 3 of TinyFish's 5 concurrent research runs.
MAX_DEEP_CONCURRENT=2
